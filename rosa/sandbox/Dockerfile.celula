# Imagen del sandbox de Rosa para celula unica (h5ad, scanpy). Sin red al
# ejecutar (docker run --network none). Es mas pesada que la tabular; se
# construye solo cuando un plan declara entorno celula_unica. scvi-tools no
# entra todavia: arrastra PyTorch (varios GB) y no hay GPU en el servidor.
FROM python:3.12-slim
RUN pip install --no-cache-dir pandas==2.2.3 numpy==2.1.3 scipy==1.14.1 statsmodels==0.14.4 anndata==0.11.4 scanpy==1.11.3 h5py==3.13.0 matplotlib==3.10.1 leidenalg==0.10.2 igraph==0.11.8
RUN useradd -m rosa
USER rosa
WORKDIR /trabajo
